<!-- 1 us_inventory, 1 Sink -->

<simulation>
  <control>
    <duration>10</duration>
    <startmonth>1</startmonth>
    <startyear>2000</startyear>
    <explicit_inventory>1</explicit_inventory>
  </control>

  <archetypes>
    <spec>
      <lib>einstein</lib>
      <name>us_inventory</name>
    </spec>
    <spec>
      <lib>cycamore</lib>
      <name>Sink</name>
    </spec>
    <spec>
      <lib>agents</lib>
      <name>NullRegion</name>
    </spec>
    <spec>
      <lib>agents</lib>
      <name>NullInst</name>
    </spec>
  </archetypes>

  <facility>
    <name>us_inventory</name>
    <config>
      <us_inventory>
        <outcommod>commodity</outcommod>
        <data_dir>../UIUC_data</data_dir>
        <coordinates_file>./coordinates.sqlite</coordinates_file>
        <preferred_facility>Surry</preferred_facility>
        <storage_type>wet</storage_type>
        <selection_policy>highest_burnup</selection_policy>
        <strict_filters>0</strict_filters>
        <allow_partial>1</allow_partial>
      </us_inventory>
    </config>
  </facility>

  <facility>
    <name>Sink</name>
    <config>
      <Sink>
        <in_commods>
          <val>commodity</val>
        </in_commods>
        <capacity>500</capacity>
      </Sink>
    </config>
  </facility>

  <region>
    <name>SingleRegion</name>
    <config><NullRegion/></config>
    <institution>
      <name>SingleInstitution</name>
      <initialfacilitylist>
        <entry>
          <prototype>us_inventory</prototype>
          <number>1</number>
        </entry>
        <entry>
          <prototype>Sink</prototype>
          <number>1</number>
        </entry>
      </initialfacilitylist>
      <config><NullInst/></config>
    </institution>
  </region>

  <recipe>
    <name>commod_recipe</name>
    <basis>mass</basis>
    <nuclide>
      <id>010010000</id>
      <comp>1</comp>
    </nuclide>
  </recipe>

</simulation>
