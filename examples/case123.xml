<!-- ==========================================================================
     EINSTEIN fuel-cycle simulation  -  Case 3: MA-only, 3 GW, Pb-cooled ADS
     Flowsheet:
        us_inventory --snf--> Separations --ma_feed--> ADS --ads_out--+
                                   ^                                    |
                                   +-------------- ads_out ------------+  (recycle)
                                   +--sep_waste--> WasteRepo

     GOAL: how much of the US SNF minor-actinide inventory can ONE 3 GW ADS
     burn, and how many units are needed to clear it in 30 years.
     ========================================================================== -->
<simulation>

  <!-- ====== TIME BASE ======================================================
       Cyclus has no "end date": you give a start + a number of timesteps.
       duration=360 monthly steps = 30 years (2025-01 .. 2054-12).
       explicit_inventory=1 writes the ExplicitInventory table so you can plot
       what each facility holds at every step.
  -->
  <control>
    <duration>360</duration>
    <startmonth>1</startmonth>
    <startyear>2025</startyear>
    <decay>never</decay>
    <explicit_inventory>1</explicit_inventory>
  </control>

  <archetypes>
    <spec><lib>einstein</lib><name>us_inventory</name></spec>
    <spec><lib>einstein</lib><name>ads</name></spec>
    <spec><lib>cycamore</lib><name>Separations</name></spec>
    <spec><lib>cycamore</lib><name>Sink</name></spec>
    <spec><lib>agents</lib><name>NullRegion</name></spec>
    <spec><lib>agents</lib><name>NullInst</name></spec>
  </archetypes>

  <!-- ====== 1) SUPPLY: the US SNF inventory ===============================
       Reads real STANDARDS 5.0.1 assemblies. It offers whole spent-fuel
       assemblies (~95% U, ~1% Pu, ~0.1% MA) on the 'snf' commodity.
       - selection_policy=highest_minor_actinide: serve the MA-richest
         assemblies first (best feed for an MA burner).
       - throughput_kg: how much SNF mass it can release per month. MA is a
         tiny fraction of SNF, so this must be LARGE to extract meaningful MA.
         250 t/month here -> ~90,000 t of SNF over 30 yr (~the whole US stock).
  -->
  <facility>
    <name>USInventory</name>
    <config>
      <us_inventory>
        <outcommod>snf</outcommod>
        <data_dir>../UIUC_data</data_dir>
        <coordinates_file>./coordinates.sqlite</coordinates_file>
        <throughput_kg>250000</throughput_kg>
        <selection_policy>highest_minor_actinide</selection_policy>
        <allow_partial>1</allow_partial>
      </us_inventory>
    </config>
  </facility>

  <!-- ====== 2) SEPARATIONS: SNF (and recycle) -> MA stream ================
       feed_commods lists BOTH the fresh SNF and the recycled ADS discharge,
       so one unit handles both. It pulls Np/Am/Cm at 99% into 'ma_feed';
       everything not captured (U, Pu, fission products) falls to the leftover
       commodity 'sep_waste'.
       - throughput: MA mass processed per month into the ADS feed.
       - buf_size -1 = unlimited stream buffer.
  -->
  <facility>
    <name>MASeparations</name>
    <config>
      <Separations>
        <feed_commods>
          <val>snf</val>
          <val>ads_out</val>
        </feed_commods>
        <feedbuf_size>1e9</feedbuf_size>
        <throughput>250000</throughput>
        <leftover_commod>sep_waste</leftover_commod>
        <leftoverbuf_size>1e12</leftoverbuf_size>
        <streams>
          <item>
            <commod>ma_feed</commod>
            <info>
              <buf_size>-1</buf_size>
              <efficiencies>
                <item><comp>Np</comp><eff>0.99</eff></item>
                <item><comp>Am</comp><eff>0.99</eff></item>
                <item><comp>Cm</comp><eff>0.99</eff></item>
              </efficiencies>
            </info>
          </item>
        </streams>
      </Separations>
    </config>
  </facility>

  <!-- ====== 3) THE ADS BURNER (Case 3) ====================================
       - incommods=ma_feed: takes the separated minor-actinide stream.
       - outcommod=ads_out: discharge goes back to Separations (recycle).
       - power_level=3000 (MW) selects the 3 GW case tier.
       - case_dir points at Wen's Case-3 folder of plot_data_*.txt files.
       - capacity = core actinide mass per load (kg).  *** SEE NOTES ***
       - cycle_time x days_per_step must land on the case's day axis:
             120 steps x 30.4375 d = 3653 d  ~ the ~3650-day Serpent run,
         i.e. one ADS cycle = one full Serpent irradiation (~40% MA burn).
       - conserve_mass=0: fissioned mass leaves the sim, logged as 'Burned'.
  -->
  <facility>
    <name>MyADS</name>
    <config>
      <ads>
        <incommods><val>ma_feed</val></incommods>
        <outcommod>ads_out</outcommod>
        <capacity>27000</capacity>
        <cycle_time>120</cycle_time>
        <refuel_time>6</refuel_time>
        <power_level>3000</power_level>
        <case_dir>./serpent_cases/no_source_892_vt_ma_Pb_3GW_fix_P</case_dir>
        <fidelity>closest</fidelity>
        <days_per_step>30.4375</days_per_step>
        <conserve_mass>0</conserve_mass>
      </ads>
    </config>
  </facility>

  <!-- ====== 4) WASTE REPOSITORY ===========================================
       Absorbs the separations leftover (U, Pu, fission products). Effectively
       infinite so it never back-pressures the flowsheet.
  -->
  <facility>
    <name>WasteRepo</name>
    <config>
      <Sink>
        <in_commods><val>sep_waste</val></in_commods>
        <capacity>1e12</capacity>
      </Sink>
    </config>
  </facility>

  <!-- ====== DEPLOYMENT ====================================================
       One of each facility, all present from t=0. To test "how many ADS,"
       raise <number> on MyADS (each still pulls from the shared ma_feed pool).
  -->
  <region>
    <name>USA</name>
    <config><NullRegion/></config>
    <institution>
      <name>FuelCycleInst</name>
      <initialfacilitylist>
        <entry><prototype>USInventory</prototype><number>1</number></entry>
        <entry><prototype>MASeparations</prototype><number>1</number></entry>
        <entry><prototype>MyADS</prototype><number>1</number></entry>
        <entry><prototype>WasteRepo</prototype><number>1</number></entry>
      </initialfacilitylist>
      <config><NullInst/></config>
    </institution>
  </region>

  <!-- No <recipe> block is needed here: us_inventory supplies REAL isotopics
       from the database, Separations splits by element, and the ADS matches by
       composition. Recipes only appear if you replace the supply with a Source. -->

</simulation>
